# ============================================================
# CyberFinGuard - Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env'
# 2. Fill in your actual values
# 3. NEVER commit '.env' to GitHub
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Change DB_PASSWORD to your PostgreSQL password
DB_HOST=localhost
DB_NAME=cyber_risk_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_PORT=5432
DB_CONNECT_TIMEOUT=5
DB_POOL_MIN=1
DB_POOL_MAX=5
CORS_ORIGINS=http://localhost:3000

# Frontend (copy this value to frontend/.env.local for npm run dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================================
# OWASP ZAP CONFIGURATION (Windows / Local)
# ============================================================
# If ZAP is running with api.disablekey=true, leave ZAP_API_KEY empty
# If ZAP is on a different machine, change localhost to its IP
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# ============================================================
# WAZUH CONFIGURATION (Kali VM / Remote Host)
# ============================================================
# Replace the IP with your Wazuh server's IP address
WAZUH_API_URL=https://CHANGE_ME_IP:55000
WAZUH_USERNAME=admin
WAZUH_PASSWORD=CHANGE_ME

# ============================================================
# OPENVAS / GREENBONE CONFIGURATION (Kali VM / Remote Host)
# ============================================================
# Replace the IP with your OpenVAS server's IP address
OPENVAS_HOST=CHANGE_ME_IP
OPENVAS_PORT=9390
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=CHANGE_ME

# ============================================================
# KEYCLOAK CONFIGURATION (Docker / Local)
# ============================================================
# If Keycloak is on port 8081, change to http://localhost:8081
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=CHANGE_ME
KEYCLOAK_REALM=master

# ============================================================
# PROWLER CONFIGURATION (Docker / Local)
# ============================================================
PROWLER_API_URL=http://localhost:8081
PROWLER_UI_URL=http://localhost:3000

# ============================================================
# THREAT INTEL APIs (Public — No Auth Needed)
# ============================================================
# These are free public APIs. Do NOT change unless they are down.
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# ============================================================
# DATA INGESTION SETTINGS
# ============================================================
POLL_INTERVAL_SECONDS=300
INGESTION_BATCH_SIZE=100
