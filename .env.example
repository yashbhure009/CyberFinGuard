# ============================================================
# CyberFinGuard - Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env'
#    Windows: copy .env.example .env
#    Linux/Mac: cp .env.example .env
# 2. Fill in your actual values
# 3. NEVER commit '.env' to GitHub
# ============================================================

# ============================================================
# DATABASE CONFIGURATION (Main Laptop)
# ============================================================
# PostgreSQL running via Docker
# Change DB_PASSWORD to your PostgreSQL password
DB_HOST=localhost
DB_NAME=cyber_risk_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_PORT=5432

# ============================================================
# OWASP ZAP (Windows/Local)
# ============================================================
# If ZAP is running with api.disablekey=true, leave ZAP_API_KEY empty
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=
ZAP_TARGET_URL=https://httpbin.org

# ============================================================
# NMAP (Windows/Local)
# ============================================================
# Full path to nmap.exe on Windows
NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe

# ============================================================
# NUCLEI (Windows/Local)
# ============================================================
# Full path to nuclei.exe
NUCLEI_PATH=D:\Tools\Nuclei\nuclei.exe

# ============================================================
# WAZUH (Laptop 2 - SIEM/EDR)
# ============================================================
# Replace IP with your Wazuh server's IP
WAZUH_API_URL=https://CHANGE_ME_IP:55000
WAZUH_USERNAME=admin
WAZUH_PASSWORD=CHANGE_ME
WAZUH_INDEXER_URL=https://CHANGE_ME_IP:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=CHANGE_ME

# ============================================================
# PROWLER (Kali VM - CSPM)
# ============================================================
# SSH access to Kali VM where Prowler is installed
KALI_HOST=CHANGE_ME_IP
KALI_SSH_PORT=22
KALI_USERNAME=kali
KALI_SSH_PASSWORD=CHANGE_ME

# ============================================================
# KEYCLOAK (Kali VM - IAM)
# ============================================================
# Keycloak running on Kali VM
KEYCLOAK_URL=http://CHANGE_ME_IP:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=CHANGE_ME
KEYCLOAK_REALM=cyberfinguard

# ============================================================
# THREAT INTELLIGENCE APIs (Public - No Auth Needed)
# ============================================================
# These are free public APIs. Do NOT change unless they are down.
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# Optional: NVD API key for higher rate limits
# Get from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ============================================================
# DATA INGESTION SETTINGS
# ============================================================
POLL_INTERVAL_SECONDS=300
INGESTION_BATCH_SIZE=100

# ============================================================
# OUTPUT PATHS
# ============================================================
UNIFIED_OUTPUT_DIR=data/unified_findings
ANALYTICS_OUTPUT_DIR=data/analytics